# Trusted tool installation; untrusted documents run later with network=none.
FROM --platform=linux/amd64 ubuntu:24.04@sha256:78d4744ead1f5b19b04d0df558ab182a5300903900755e515b2ca4d10eb2044d
COPY image_inventory.py /opt/kb01/image_inventory.py
RUN --mount=type=secret,id=system_ca,required=false,mode=0444 \
    set -eu; \
    if [ -s /run/secrets/system_ca ]; then \
      printf 'Acquire::https::CaInfo "/run/secrets/system_ca";\n' > /etc/apt/apt.conf.d/99-session-ca; \
    fi; \
    mkdir -p /opt/kb01-provenance; \
    printf '%s\n' 'Acquire::https::Timeout "60";' 'Acquire::Retries "1";' \
      > /etc/apt/apt.conf.d/99-kb01-download-bounds; \
    rm -f /etc/apt/sources.list.d/debian.sources /etc/apt/sources.list.d/ubuntu.sources /etc/apt/apt.conf.d/docker-clean; \
    printf '%s\n' \
      'deb [check-valid-until=no signed-by=/usr/share/keyrings/ubuntu-archive-keyring.gpg] https://snapshot.ubuntu.com/ubuntu/20261028T000000Z noble main universe' \
      'deb [check-valid-until=no signed-by=/usr/share/keyrings/ubuntu-archive-keyring.gpg] https://snapshot.ubuntu.com/ubuntu/20261028T000000Z noble-updates main universe' \
      'deb [check-valid-until=no signed-by=/usr/share/keyrings/ubuntu-archive-keyring.gpg] https://snapshot.ubuntu.com/ubuntu/20261028T000000Z noble-security main universe' \
      > /etc/apt/sources.list; \
    apt-get update; \
    cp /var/lib/apt/lists/*InRelease /opt/kb01-provenance/; \
    apt-cache policy > /opt/kb01-provenance/apt-policy.txt; \
    apt-get -y --download-only upgrade; \
    apt-get -y upgrade; \
    apt-get -y --download-only --no-install-recommends install \
      python3 libreoffice-writer poppler-utils libarchive-tools \
      clamav clamav-freshclam ca-certificates gpg gpgv \
      tesseract-ocr tesseract-ocr-eng tesseract-ocr-chi-sim tesseract-ocr-chi-tra \
      tesseract-ocr-ara tesseract-ocr-heb tesseract-ocr-osd \
      fonts-dejavu-core fonts-noto-core fonts-noto-cjk; \
    apt-get -y --no-install-recommends install \
      python3 libreoffice-writer poppler-utils libarchive-tools \
      clamav clamav-freshclam ca-certificates gpg gpgv \
      tesseract-ocr tesseract-ocr-eng tesseract-ocr-chi-sim tesseract-ocr-chi-tra \
      tesseract-ocr-ara tesseract-ocr-heb tesseract-ocr-osd \
      fonts-dejavu-core fonts-noto-core fonts-noto-cjk; \
    dpkg --compare-versions "$(dpkg-query -W -f='${Version}' libxml2)" ge "2.9.14+dfsg-1.3ubuntu3.8"; \
    python3 /opt/kb01/image_inventory.py --apt-build; \
    rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*.deb /etc/apt/apt.conf.d/99-session-ca
COPY crossborder_compliance /opt/knowledge-src/crossborder_compliance
RUN chmod -R a+rX /opt/knowledge-src /opt/kb01 /opt/kb01-provenance
ENV PYTHONPATH=/opt/knowledge-src LANG=C.UTF-8 LC_ALL=C.UTF-8
WORKDIR /tmp
USER 1000
CMD ["/usr/bin/python3", "--version"]
