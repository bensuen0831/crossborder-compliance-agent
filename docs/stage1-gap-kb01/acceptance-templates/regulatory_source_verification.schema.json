{
  "$defs": {
    "RegulatorySourcePin": {
      "additionalProperties": false,
      "properties": {
        "knowledge_version_id": {
          "format": "uuid",
          "title": "Knowledge Version Id",
          "type": "string"
        },
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "structure_node_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 1000,
          "minItems": 1,
          "title": "Structure Node Ids",
          "type": "array"
        }
      },
      "required": [
        "knowledge_version_id",
        "content_sha256",
        "structure_node_ids"
      ],
      "title": "RegulatorySourcePin",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "dataset_kind": {
      "enum": [
        "L1_SYNTHETIC_GOVERNED",
        "L2_REAL_REGULATORY"
      ],
      "title": "Dataset Kind",
      "type": "string"
    },
    "synthetic_label": {
      "anyOf": [
        {
          "const": "SYNTHETIC_GOVERNED_TEST_DATA",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Synthetic Label"
    },
    "schema_version": {
      "const": "KB01_F0_SOURCE_VERIFICATION_V1",
      "default": "KB01_F0_SOURCE_VERIFICATION_V1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_pin": {
      "$ref": "#/$defs/RegulatorySourcePin"
    },
    "jurisdiction_id": {
      "format": "uuid",
      "title": "Jurisdiction Id",
      "type": "string"
    },
    "expert_authorization_version_id": {
      "format": "uuid",
      "title": "Expert Authorization Version Id",
      "type": "string"
    },
    "official_source_record_ref": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Official Source Record Ref",
      "type": "string"
    },
    "effective_from": {
      "format": "date",
      "title": "Effective From",
      "type": "string"
    },
    "effective_to": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Effective To"
    },
    "verification_notes": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Verification Notes",
      "type": "string"
    }
  },
  "required": [
    "dataset_kind",
    "source_pin",
    "jurisdiction_id",
    "expert_authorization_version_id",
    "official_source_record_ref",
    "effective_from",
    "verification_notes"
  ],
  "title": "RegulatorySourceVerification",
  "type": "object"
}
