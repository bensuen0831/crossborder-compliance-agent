          },
          "expected_record_version": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Expected Record Version"
          },
          "provider_version_id": {
            "type": "string",
            "format": "uuid",
            "title": "Provider Version Id"
          },
          "remote_model_name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Remote Model Name"
          },
          "display_name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Display Name"
          },
          "capabilities": {
            "items": {
              "$ref": "#/components/schemas/ModelCapabilityCode"
            },
            "type": "array",
            "minItems": 1,
            "title": "Capabilities"
          },
          "operations": {
            "items": {
              "$ref": "#/components/schemas/ModelOperation"
            },
            "type": "array",
            "minItems": 1,
            "title": "Operations"
          },
          "max_output_tokens": {
            "type": "integer",
            "maximum": 65536.0,
            "minimum": 1.0,
            "title": "Max Output Tokens"
          },
          "embedding_dimension": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 16000.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Embedding Dimension"
          },
          "priority": {
            "type": "integer",
